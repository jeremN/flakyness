# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.svelte-kit/

# Environment
.env
.env.local
.env.*.local
# Hand-made backups (.env.bak, .env.orig, .env.2026-07-28…) carry the same
# secrets as .env but were NOT matched by the patterns above — a `git add -A`
# would have committed DATABASE_URL and ADMIN_TOKEN in plaintext.
.env.*
# …but the checked-in templates must stay tracked.
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test coverage
coverage/

# Playwright (apps/dashboard/e2e)
playwright-report/
test-results/
apps/dashboard/e2e/.artifacts/

# Vitest browser mode (apps/dashboard/*.svelte.test.ts) run artifacts
.vitest-attachments/
__screenshots__/

# Docker
postgres_data/

# Stryker mutation-testing output
reports/
.stryker-tmp/
