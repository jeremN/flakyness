# Database
# Generate a secure password: openssl rand -hex 16
DATABASE_URL=postgres://postgres:<YOUR_DB_PASSWORD>@localhost:5432/flackyness
DB_PASSWORD=<YOUR_DB_PASSWORD>

# API
API_PORT=8080
API_HOST=0.0.0.0

# Dashboard
PUBLIC_API_URL=http://localhost:8080

# Security
# Generate a secure token: openssl rand -hex 32
ADMIN_TOKEN=change-me-in-production

# Read endpoints (GET /api/v1/projects/*, /api/v1/tests/*) — unset means they
# are OPEN to anyone who can reach the API, and GET /api/v1/projects
# enumerates every project on the instance. That is the pre-plan-041 behaviour
# and remains the default so upgrades never break; the API logs a warning at
# boot when this is unset. Set it to require a Bearer token on reads. The
# dashboard must be given the SAME value (it presents it on every SSR call).
# A project token also grants read access to its own project, which is how the
# GitHub Action reads its quarantine list without a second secret.
# Generate a secure token: openssl rand -hex 32
# READ_TOKEN=

# The dashboard authenticates real user accounts, not a shared password
# (plan 059) — there is no DASHBOARD_PASSWORD to set. Create the first
# global-admin account with ADMIN_TOKEN before anyone can sign in; see
# "Create Your First User Account" in docs/GETTING_STARTED.md.

# Marks the dashboard's own session cookie (set at /login) Secure. Unset
# (or "false") is correct for a plain-http deployment — setting it while
# serving the dashboard over http makes the browser silently drop the
# cookie, and sign-in breaks. Set to "true" once the dashboard is actually
# served over https (e.g. behind a TLS-terminating reverse proxy). Does
# NOT need to match the API's own COOKIE_SECURE (see docs/API.md) — the
# dashboard's cookie is the only one a browser ever holds.
# COOKIE_SECURE=true

# Rate limiting — trusted reverse proxy IPs (comma-separated). Set this to
# the address of whatever reaches the API on a browser's behalf: the
# dashboard container (it calls the API server-side, so every user's request
# otherwise arrives from the SAME socket) or your reverse proxy. Left unset,
# ALL callers behind that one address share a single rate-limit bucket —
# ~100 API calls and 10 sign-ins per minute for the whole installation,
# regardless of how many people are using it. docker-compose.yml sets this
# automatically to the dashboard container's fixed address (172.28.0.10).
# TRUSTED_PROXY_IPS=127.0.0.1,172.17.0.1

# Monitoring — set to enable GET /metrics (Prometheus scrape endpoint, unset = 404)
# Generate a secure token: openssl rand -hex 32
# METRICS_TOKEN=
